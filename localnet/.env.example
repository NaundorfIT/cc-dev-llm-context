# LocalNet kickstart configuration. Copy to .env and adjust.
#   cp .env.example .env
#
# This wrapper downloads and runs the OFFICIAL Splice LocalNet bundle
# (Apache-2.0). Nothing third-party is vendored into this repo.

# ---------------------------------------------------------------------------
# Splice version
# ---------------------------------------------------------------------------
# The Splice release whose LocalNet bundle to download and run. This becomes
# the docker image tag (IMAGE_TAG). Pick a published release from:
#   https://github.com/digital-asset/decentralized-canton-sync/releases
# Canton Network LocalNet docs (preferred over the deprecated sync.global page):
#   https://docs.canton.network/sdks-tools/development-tools/localnet
SPLICE_VERSION=0.6.3

# Where to download the LocalNet release bundle from. Leave blank to let the
# fetch script derive a URL from SPLICE_VERSION; set it explicitly to a release
# asset URL if the derived URL does not resolve. Archive name:
#   ${SPLICE_VERSION}_splice-node.tar.gz
SPLICE_BUNDLE_URL=

# ---------------------------------------------------------------------------
# Validator profiles (which nodes to run). Turn off nodes to save memory.
# Docker Desktop needs >= 8 GB; disabling app-user/sv reduces that.
# ---------------------------------------------------------------------------
SV_PROFILE=on
APP_PROVIDER_PROFILE=on
APP_USER_PROFILE=on

# ---------------------------------------------------------------------------
# Ports (defaults match the upstream LocalNet bundle).
# LocalNet uses a prefix-suffix pattern:
#   prefix: 2xxx = app-user, 3xxx = app-provider, 4xxx = super validator (sv)
#   suffix: 901 = Ledger API (gRPC), 902 = Admin API, 903 = Validator API,
#           975 = JSON Ledger API, 900 = HTTP healthcheck
# Examples:
#   app-user   Ledger API (gRPC) : localhost:2901   JSON API: localhost:2975
#   app-provider Ledger API (gRPC): localhost:3901  JSON API: localhost:3975
#   app-user wallet    : http://wallet.localhost:2000
#   app-provider wallet: http://wallet.localhost:3000
#   Scan / SV UI: http://scan.localhost:4000  http://sv.localhost:4000
# ---------------------------------------------------------------------------
DB_PORT=5432
