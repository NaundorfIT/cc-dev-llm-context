# DevNet validator configuration. Copy to .env and fill in.
#   cp .env.example .env
#
# This wrapper drives the OFFICIAL Splice validator Docker Compose
# (splice-node/docker-compose/validator) for a DevNet node. Nothing
# third-party is vendored. A real validator also needs a static egress IP
# allowlisted by your Super Validator sponsor (see validator/README.md).

# ---------------------------------------------------------------------------
# Splice version (becomes IMAGE_TAG and the bundle to download)
# ---------------------------------------------------------------------------
SPLICE_VERSION=0.6.3

# Optional explicit bundle URL. Leave blank to derive a best-effort URL from
# SPLICE_VERSION; set it to the official 'Download Bundle' link if that fails.
# https://github.com/digital-asset/decentralized-canton-sync/releases
SPLICE_BUNDLE_URL=

# ---------------------------------------------------------------------------
# Network parameters (obtain from your sponsor and the public SV network page)
# ---------------------------------------------------------------------------
# SV APP url (starts with sv., NOT the Scan url). Used both to self-generate the
# DevNet onboarding secret and as the sponsor URL passed to start.sh.
SPONSOR_SV_URL=

# Trusted Scan url (starts with scan.).
SCAN_URL=

# Frozen per-network migration id (published at https://sync.global/sv-network/).
MIGRATION_ID=

# Immutable party hint: <organization>-<function>-<enumerator>, e.g. acme-wallet-1.
# Becomes part of your validator operator party id. Choose carefully.
PARTY_HINT=

# One-time onboarding secret. On DevNet you can leave this blank and run
# `make prepare-secret` to self-generate one (valid ~1 hour). On a re-start of an
# already-onboarded node, leave blank (the wrapper passes -o "").
ONBOARDING_SECRET=

# ---------------------------------------------------------------------------
# Feature toggles
# ---------------------------------------------------------------------------
ENABLE_WALLET=on    # -w : wallet UI
ENABLE_AUTH=off     # -a : authentication (requires an OIDC provider)
